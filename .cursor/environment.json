{
  "name": "FitFocus",
  "install": "npm install",
  "terminals": [
    {
      "name": "server",
      "command": "npm run dev:server",
      "description": "FitFocus Express API (SQLite) on http://localhost:4000"
    },
    {
      "name": "client",
      "command": "npm run dev:client",
      "description": "FitFocus Vite + React dev server on http://localhost:5173"
    }
  ],
  "ports": [
    { "name": "api", "port": 4000 },
    { "name": "web", "port": 5173 }
  ]
}
